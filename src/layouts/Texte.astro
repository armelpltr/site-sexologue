---
import Base from '@/layouts/Base.astro';

interface Props {
  titre: string;
  description?: string;
  surtitre?: string;
}
const { titre, description, surtitre } = Astro.props;
---

<Base titre={titre} description={description}>
  <article class="conteneur max-w-3xl pt-12 sm:pt-16">
    {surtitre && <p class="surtitre">{surtitre}</p>}
    <h1 class="mt-2 text-4xl sm:text-5xl">{titre}</h1>
    <div class="prose prose-stone mt-10 max-w-none prose-headings:font-titre prose-headings:font-normal prose-a:text-sauge-fonce">
      <slot />
    </div>
  </article>
</Base>
