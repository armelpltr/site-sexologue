---
/** Icônes au trait, douces et neutres, pour les cartes de motifs. */
interface Props {
  nom: 'couple' | 'desir' | 'douleur' | 'identite' | 'fonction' | 'parcours' | 'visio' | 'cabinet' | 'horloge' | 'cadenas';
  class?: string;
}
const { nom, class: classe = 'h-7 w-7' } = Astro.props;

const chemins: Record<Props['nom'], string> = {
  couple: '<circle cx="9" cy="8" r="3"/><circle cx="16" cy="9" r="2.5"/><path d="M3.5 20c0-3.5 2.5-6 5.5-6s5.5 2.5 5.5 6"/><path d="M14.5 14.6c.5-.2 1-.3 1.5-.3 2.5 0 4.5 2.2 4.5 5.2"/>',
  desir: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
  douleur: '<path d="M12 3c3 4 6 7 6 11a6 6 0 0 1-12 0c0-4 3-7 6-11z"/><path d="M9.5 15a2.5 2.5 0 0 0 2.5 2.5"/>',
  identite: '<circle cx="12" cy="12" r="8"/><path d="M12 4v16M4 12h16" opacity=".5"/><circle cx="12" cy="12" r="3"/>',
  fonction: '<path d="M4 15c2-6 4-6 6 0s4 6 6 0 3-5 4-3"/>',
  parcours: '<path d="M5 19c3 0 3-5 7-5s4-5 7-5"/><circle cx="5" cy="19" r="1.5"/><circle cx="19" cy="9" r="1.5"/>',
  visio: '<rect x="3" y="6" width="13" height="12" rx="2"/><path d="M16 10l5-3v10l-5-3z"/>',
  cabinet: '<path d="M4 20V9l8-5 8 5v11"/><path d="M10 20v-6h4v6"/>',
  horloge: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>',
  cadenas: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
};
---

<svg
  class={classe}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={chemins[nom]}
/>
