---
import { site, navigation, adresseComplete, telLien } from '@/config/site';
const annee = new Date().getFullYear();
---

<footer class="mt-24 bg-sable">
  <div class="conteneur grid gap-10 py-14 text-sm text-encre-douce sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <p class="font-titre text-xl text-encre">{site.nom}</p>
      <p class="mt-1">{site.titre}</p>
      <address class="mt-4 not-italic">
        <span class="block">{adresseComplete}</span>
        <a class="lien inline-block py-2" href={telLien}>{site.contact.telephone}</a><br />
        <a class="lien inline-block py-2" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </address>
    </div>
    <nav aria-label="Pied de page">
      <ul class="space-y-2">
        {navigation.map((n) => <li><a class="hover:text-sauge-fonce" href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <ul class="space-y-2">
      <li><a class="hover:text-sauge-fonce" href="/contact">Contact & rendez-vous</a></li>
      <li><a class="hover:text-sauge-fonce" href="/mentions-legales">Mentions légales</a></li>
      <li><a class="hover:text-sauge-fonce" href="/confidentialite">Politique de confidentialité</a></li>
    </ul>
  </div>
  <div class="border-t border-sable-fonce">
    <div class="conteneur flex flex-col gap-2 py-5 text-sm text-encre-douce sm:flex-row sm:items-center sm:justify-between">
      <p role="note">
        En cas d'urgence, appelez le <a class="lien font-medium" href="tel:15">15</a> ou le
        <a class="lien font-medium" href="tel:3114">3114</a>.
      </p>
      <p>© {annee} {site.nom}</p>
    </div>
  </div>
</footer>
