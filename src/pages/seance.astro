---
import Base from '@/layouts/Base.astro';
import Icone from '@/components/Icone.astro';
import { site } from '@/config/site';

const etapes = [
  {
    titre: 'La prise de contact',
    texte: `Vous réservez en ligne sur ${site.contact.nomPlateformeRdv}, par téléphone ou via le formulaire. Inutile d’expliquer votre situation à ce stade.`,
  },
  {
    titre: 'La première séance',
    texte: 'C’est un temps pour faire connaissance et comprendre ce qui vous amène. Vous parlez de ce que vous souhaitez, à votre rythme. Nous voyons ensemble si un accompagnement vous convient et sous quelle forme.',
  },
  {
    titre: 'Les séances suivantes',
    texte: 'Leur nombre et leur fréquence dépendent de votre situation et de vos besoins. Ils se décident ensemble et peuvent être revus à tout moment. Vous restez libre d’arrêter quand vous le souhaitez.',
  },
];
const infos = [
  { icone: 'horloge', titre: 'Durée', texte: '[Environ 50 minutes en individuel, 1 h 15 en couple.]' },
  { icone: 'cabinet', titre: 'Au cabinet', texte: 'Un lieu calme et discret, pensé pour que vous vous sentiez à l’aise.' },
  { icone: 'visio', titre: 'En visio', texte: '[Via une plateforme sécurisée. Il suffit d’un endroit calme où vous ne serez pas dérangé·e.]' },
  { icone: 'cadenas', titre: 'Confidentialité', texte: 'Tout ce qui est dit en séance est couvert par le secret professionnel.' },
] as const;
---

<Base titre="Déroulement d’une séance" description="Première séance, durée, consultation au cabinet ou en visio, confidentialité : comment se passe une consultation en sexologie.">
  <div class="conteneur max-w-3xl pt-12 sm:pt-16">
    <p class="surtitre">Ce qui vous attend</p>
    <h1 class="mt-2 text-4xl sm:text-5xl">Déroulement d’une séance</h1>
    <p class="mt-5 text-lg text-encre-douce">
      Une consultation en sexologie est avant tout un <strong class="font-medium text-encre">échange par la parole</strong>.
      Il n’y a ni examen physique ni exercice imposé pendant la séance.
    </p>
  </div>

  <ol class="conteneur mt-12 max-w-3xl space-y-6">
    {
      etapes.map((e, i) => (
        <li class="carte flex gap-5">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-sauge-clair font-titre text-lg text-sauge-fonce" aria-hidden="true">
            {i + 1}
          </span>
          <div>
            <h2 class="text-xl">{e.titre}</h2>
            <p class="mt-2 text-encre-douce">{e.texte}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <section class="conteneur mt-20" aria-labelledby="titre-pratique">
    <h2 id="titre-pratique" class="text-3xl">En pratique</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        infos.map((info) => (
          <div class="flex gap-4 rounded-doux bg-sable p-6">
            <Icone nom={info.icone} class="h-6 w-6 shrink-0 text-sauge-fonce" />
            <div>
              <h3 class="font-sans text-base font-medium">{info.titre}</h3>
              <p class="mt-1 text-[0.95rem] text-encre-douce">{info.texte}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="conteneur mt-16 max-w-3xl">
    <h2 class="text-2xl">Venir seul·e ou en couple ?</h2>
    <p class="mt-3 text-encre-douce">
      Les deux sont possibles. Une difficulté vécue dans le couple peut être abordée à deux, individuellement, ou en
      alternant. Ce qui est confié en séance individuelle n’est pas rapporté à l’autre partenaire sans votre accord.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/contact" class="bouton">Prendre rendez-vous</a>
      <a href="/tarifs" class="bouton-secondaire">Tarifs et accès</a>
    </div>
  </section>
</Base>
